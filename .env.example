# Select "local" during migration or "sanity" for CMS-backed content.
MIND_MARGIN_CONTENT_SOURCE=local

# Public Sanity identifiers. These are safe to expose to the browser and are
# required for /studio and MIND_MARGIN_CONTENT_SOURCE=sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Canonical publication origin. Required for production builds/runtime.
# Set the real HTTPS origin at deployment; for local production-mode QA explicitly
# set http://localhost:3000. Never deploy that local QA value.
SITE_ORIGIN=

# Exact frontend origin loaded by the embedded Presentation tool.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Server-only, permanent Viewer token. Required only for authenticated draft
# preview; ordinary reads from the public production dataset do not use it.
SANITY_API_READ_TOKEN=

# Server-only, permanent random secret shared only with the Sanity webhook.
# Use at least 32 random bytes. It is not an API token and grants no CMS access.
SANITY_REVALIDATE_SECRET=

# Server-only and migration-only. Required only for `npm run sanity:seed -- --apply`.
# Leave empty for normal operation; P10's temporary migration token is retired.
SANITY_API_WRITE_TOKEN=
