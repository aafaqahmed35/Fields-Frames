{
  "name": "mind-and-margin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "seo:validate": "node --import tsx scripts/validate-seo.ts",
    "publishing:validate": "node --import tsx scripts/validate-publishing.ts",
    "sanity:schema": "sanity schema extract --enforce-required-fields --force",
    "sanity:typegen": "sanity typegen generate",
    "sanity:validate": "npm run sanity:schema && npm run sanity:typegen && npm run content:validate && npm run publishing:validate",
    "sanity:seed": "node --import tsx scripts/seed-sanity.ts",
    "production:check": "node --import tsx scripts/validate-production.ts",
    "production:validate": "npm run sanity:validate && npm run seo:validate && npm run production:check && npm run lint && tsc --noEmit && npm run build && git diff --check"
  },
  "dependencies": {
    "@sanity/image-url": "2.1.1",
    "@sanity/webhook": "4.0.4",
    "next": "16.3.6",
    "next-sanity": "13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.15.0",
    "server-only": "0.0.1",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "@module-federation/dts-plugin": {
      "adm-zip": "0.6.1"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "1.9.0"
    }
  }
}
